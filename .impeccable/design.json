    "rules": [
      {
        "name": "The Explicit Status Rule",
        "body": "Color supplements readable state; it never establishes health or carries meaning alone.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve selected context during refresh and keep dataset identity visible.",
      "Do pair severity color with its readable label.",
      "Do keep long evidence readable through wrapping, expansion and contained scrolling."
    ],
    "donts": [
      "Don\u2019t let decorative treatment compete with investigation evidence.",
